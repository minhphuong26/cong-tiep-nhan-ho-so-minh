# Sao chép file này thành .env.local (hoặc .env) rồi điền giá trị thật.
# Tuần 2: chỉ cần GEMINI_API_KEY để chatbot trên trang chủ trả lời được. Các biến còn lại dùng từ Tuần 3.

# Gemini (Tuần 2: chatbot QnA). Lấy key tại https://aistudio.google.com/apikey
# Chỉ dùng phía server, không thêm tiền tố NEXT_PUBLIC_
GEMINI_API_KEY=

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
